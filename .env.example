# Reddit API credentials are optional. RSS is the default source.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT="twitter-auto/0.1 by u_your_reddit_username"

# Telegram approval bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X/Twitter write-only publishing credentials. The app does not read analytics.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_DAILY_CALL_LIMIT=10
X_MAX_POST_CHARS=800
APPEND_SOURCE_TO_POST=false

# Optional DeepSeek rewriting layer. If omitted, local humanizer is used.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TARGET_CHARS=600

# Style profile selection: daily keeps one voice per day; random changes per run.
STYLE_PROFILE_MODE=daily
STYLE_PROFILE_SEED=
